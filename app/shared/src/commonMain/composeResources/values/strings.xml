    <string name="privacy_title">What NextData stores, and where</string>
    <string name="privacy_what_title">Profiles</string>
    <string name="privacy_what_body">Name, protocol, server, username, colour, favorites and settings are stored by the engine in the app data folder.</string>
    <string name="privacy_secrets_title">Secrets</string>
    <string name="privacy_secrets_body">Passwords, keys and passphrases are sent to the engine only when you save a profile. The app never reads them back and never writes them to disk itself.</string>
    <string name="privacy_key_title">Master key</string>
    <string name="privacy_pmk_dpapi">The 32-byte master key that protects your secrets is wrapped with Windows DPAPI and bound to your Windows account.</string>
    <string name="privacy_pmk_keystore">The 32-byte master key that protects your secrets is wrapped by a non-exportable key in the Android Keystore. App backup is disabled.</string>
    <string name="privacy_pmk_other">The master key that protects your secrets is protected by the operating system.</string>
    <string name="privacy_where_title">Data folder</string>
    <string name="privacy_where_body">%1$s</string>
    <string name="privacy_trust_title">Trusted servers</string>
    <string name="privacy_trust_body">Host keys and accepted certificates are remembered per profile so that changes are detected. They are erased when you delete the profile.</string>
    <string name="privacy_export_title">Exports</string>
    <string name="privacy_export_body">.ndprofile files are encrypted with your passphrase and never contain credentials.</string>
    <string name="privacy_network_title">Network</string>
    <string name="privacy_network_body">NextData only connects to the servers you configure. It has no analytics and sends nothing to third parties.</string>

