    <string name="onboarding_title">Your files, wherever they are</string>
    <string name="onboarding_subtitle">NextData connects to your own servers and storage.</string>
    <string name="onboarding_what_title">Browse and transfer</string>
    <string name="onboarding_what_body">Work with folders and files on SFTP, WebDAV and S3 servers, as if they were on this device.</string>
    <string name="onboarding_how_title">Add a profile</string>
    <string name="onboarding_how_body">A profile describes one server and account. A short guide checks the details and can test the connection before you save.</string>
    <string name="onboarding_privacy_title">Private by design</string>
    <string name="onboarding_privacy_body">Passwords and keys are stored encrypted on this device. NextData has no analytics and talks only to the servers you add.</string>
